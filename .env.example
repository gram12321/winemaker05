# Server-only connections; never prefix these with VITE_. The authority prefers
# the shared session pooler URL and falls back to the direct database URL.
DATABASE_URL=
POSTGRES_POOLER_URL=
# Optional CA PEM path downloaded from Supabase Database > Settings > SSL
POSTGRES_SSL_ROOT_CERT=
# Explicit initial calendar settings for newly created companies
WINEMAKER_WEEKS_PER_SEASON=
WINEMAKER_SEASONS_PER_YEAR=
WINEMAKER_START_YEAR=
WINEMAKER_START_SEASON=
WINEMAKER_START_WEEK=
